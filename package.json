{
  "name": "Notesprint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pages:build": "npx @cloudflare/next-on-pages",
    "deploy": "npx @cloudflare/next-on-pages",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "migrate:questions": "tsx scripts/migrate-questions.ts",
